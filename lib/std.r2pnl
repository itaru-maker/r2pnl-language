! stack
'swap { 1 roll } fn
'dup { 0 pick } fn
'rot { 2 roll } fn
'over { 1 pick } fn
'nip { swap drop } fn
'tuck { swap over } fn
'2drop { drop drop } fn
'2dup { over over } fn
'noop { } fn
'2pick { 2 pick } fn
'ndrop { { drop } repeat } fn

!logic
'not { { #false } { #true } if } fn

'or {
    {
        drop #true
    } {
        { #true } { #false } if
    } if
} fn

'and {
    {
        { #true } { #false } if
    } {
        drop #false
    } if
} fn

'xor {
    {
        { #false } { #true } if
    } {
        { #true } { #false } if 
    } if
} fn

!control
'do { call } fn
'when { { } if } fn
'unless { { } swap if } fn
'dip { swap 1 pack concat do } fn
'2dip { swap rot 2 pack concat do } fn
'bi { { { dup } dip dip } dip do } fn
'bi* { { dip } dip call } fn
'bi@ { dup bi* } fn
'tri { { { keep } dip keep } dip call } fn
'keep { over { call } dip } fn

!comp
'/= { = not } fn
'<= { > not } fn
'>= { < not } fn

!math
'%% { % 0 = } fn
'even? { 2 % 0 = } fn
'odd? { even? not } fn
'positive? { 0 > } fn
'negative? { 0 < } fn
'zero? { 0 = } fn
'neg { 0 swap - } fn
'abs { dup negative? { neg } when } fn
'min { 2dup > { nip } { drop } if } fn
'max { 2dup < { nip } { drop } if } fn
'// { / floor } fn
'sum { 0 { + } fold } fn
'1+ { 1 + } fn
'1- { 1 - } fn

!block
'uncons { { head } { tail } bi } fn
'1block { 1 pack } fn

!var
'lfn {
    1block { scope } concat fn
} fn

'bind {
    reverse { swap var } each
} fn

!block
'iota { 0 swap range } fn
'1to { 1 swap 1+ range } fn !1からの閉
'to { 1+ range } fn !閉区間

!higher order
'partition {
    2dup filter { { not } concat filter } dip swap
} fn

'member? { { lst v } bind
    lst { v equal? } any?
} lfn

'any? { filter empty? not } fn
'all? { { not } concat any? not } fn

!io
'newline { "\n" print } fn
