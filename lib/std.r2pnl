! stack
'swap { 1 roll } proc let
'dup { 0 pick } proc let
'rot { 2 roll } proc let
'over { 1 pick } proc let
'nip { swap drop } proc let
'tuck { swap over } proc let
'2drop { drop drop } proc let
'2dup { over over } proc let
'noop { } proc let

!logic
'not { { #false } { #true } if } proc let
'or {
    {
        { dup } { drop drop #true }
        { drop dup } { drop #true }
        { #true } { drop #false }
    } cond  
} proc let

'and {
    {
        { #true } { #false } if
    } {
        drop #false
    } if
} proc let

'xor {
    {
        { #false } { #true } if
    } {
        { #true } { #false } if 
    } if
} proc let

!control
'when { { } if } proc let
'unless { { } swap if } proc let

!var
'args { reverse { swap let } each } proc let
'update { swap dup get rot do set } proc let
'inc { { 1 + } update } proc let
'dec { { 1 - } update } proc let

!comp
'/= { = not } proc let
'<= { > not } proc let
'>= { < not } proc let

!math
'%% { % 0 = } proc let
'even? { 2 % 0 = } proc let
'odd? { even? not } proc let
'positive? { 0 > } proc let
'negative? { 0 < } proc let
'zero? { 0 = } proc let
'neg { 0 swap - } proc let
'abs { dup negative? { neg } when } proc let
'min { 2dup > { nip } { drop } if } proc let
'max { 2dup < { nip } { drop } if } proc let
'// { / floor } proc let

!string
!結構便利だったので標準ライブラリに
'split { { str c } args
    'i 0 let
    'acc { } let
    'cur "" let
    { i str length < } {
        str i nth c equal? {
            cur empty? {
                'acc cur acc cons set
                'cur "" set
            } unless
        } {
            'cur cur str i nth concat set
        } if
        'i inc
    } while
    cur empty? not {
        'acc cur acc cons set
    } when
    acc reverse
} fn let

