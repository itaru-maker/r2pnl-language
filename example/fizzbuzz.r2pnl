
'count 1 let

'fizzbuzz-cond {
    dup 15 mod 0 = { drop "fizzbuzz" } {
        dup 5 mod 0 = { drop "buzz" } {
            dup 3 mod 0 = { drop "fizz" } {
                noop
            } if
        } if 
    } if 
} fn let


'fizzbuzz {
    99 {
        count fizzbuzz-cond print
        newline
        'count count 1 + set
    } repeat
} fn let


fizzbuzz



