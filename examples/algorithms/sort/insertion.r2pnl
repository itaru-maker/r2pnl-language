! ソート済みのlstに対し、vを追加する
'insert { !v lst -> newlst
    {
        { dup empty? } { drop 1 pack }
        { 2dup head <= } { cons }
        { #true } { dup head rot rot tail insert cons }
    } cond
} proc let

'sort {
    {
        { dup empty? } { drop { } }
        { #true } { dup head swap tail sort insert }
    } cond
} proc let

