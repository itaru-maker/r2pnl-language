'merge-sort { { arr } args
    arr length 1 <= {
        arr
    } {
        'mid arr length 2 // let
        'l arr 0 mid slice let
        'r arr mid arr length slice let
        l merge-sort r merge-sort merge
    } if
} fn let

'merge { { l r } args
    'result { } let
    'i 0 let
    'j 0 let
    { l length i > r length j > and } {
        l i nth r j nth <= {
            'result result [ l i nth ] concat set
            'i i 1 + set
        } {
            'result result [ r j nth ] concat set
            'j j 1 + set
        } if
    } while
    'result result l i l length slice concat set
    'result result r j r length slice concat set
    result
} fn let


