'sieve {
    'limit swap let
    'numbers 2 limit 1 + range let
    'acc { } let
    'p 0 let
    { numbers null-block? not } {
        'p numbers head set
        'numbers numbers tail set
        'acc p acc cons set !生き残ってるやつは素数

        'numbers numbers { p divisible? not } filter set
    } while
    acc reverse
} fn let

