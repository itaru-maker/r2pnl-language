'prime? { { n } args
    {
        { n 1 <= } { #false }
        { n 2 = } { #true }
        { n even? } { #false }
        { #true } {
            'ok #true let
            'd 3 let !割る数
            { d d * n <= ok and } {
                n d %% {
                    'ok #false set
                } when
                'd { 2 + } update
            } while
            ok
        } 
    } cond
} fn let

'make-prime-list { { limit } args
    1 limit 1 + range { prime? } filter
} fn let

100 make-prime-list .
