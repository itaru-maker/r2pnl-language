'gcd {
    'b swap let
    'a swap let
    { b 0 /= } {
        'a b, 'b a b %, set set !先に定義するとずれるので貯めてから
    } while
    a
} fn let


'gcd2 { !再帰var
    'b swap let
    'a swap let
    b 0 = {
        a
    } {
        b a b % gcd2
    } if
} fn let
 
24 36 gcd print
newline
24 36 gcd2 print
newline
