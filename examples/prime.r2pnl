'prime? {
    'n swap var
    {
        { n 1 <= } { #false }
        { n 2 = } { #true }
        { n 2 %% } { #false }
        { #true } {
            2 n range { n swap %% } filter empty?
        }
    } cond
    'n forget
} fn

'make-prime-list {
    2 swap 1+ range { prime? } filter
} fn

100 make-prime-list .
