'fib {
    {
        { dup 0 <= } { drop 0 }
        { dup 1 = } { drop 1 }
        { #true } { dup 1 - fib swap 2 - fib + }
    } cond
} fn

20 fib print newline

'fib-loop { { n } bind
    n zero? {
        0
    } {
        0 1
        n 1- {
          swap over +  
        } repeat
        nip
    } if
} lfn

100000 fib-loop . newline

'fib-memo { { n memo } bind
    {
        { memo n plist-has? } { memo n plist-get }
        { n 1 <= } { n }
        { #true } {
            n 1- memo fib-memo
            n 2 - memo fib-memo
            +
        }
    } cond
} lfn

20 { } fib-memo . newline
!plistはo(n)なので対して速くならない（というか遅くなる）
