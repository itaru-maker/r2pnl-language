!あくまで「もどき」です。（小文字のみ）
'alphabet "abcdefghijklmnopqrstuvwxyz" let

'find-index {
    'char swap let
    'i 0 let
    'found -1 let
    25 {
        alphabet i string-nth char equal {
            'found i set
        } {
            noop
        } if
        'i i 1 + set 
    } repeat
    found
} fn let

'char-rot {
    'char swap let
    'idx char find-index let
    idx -1 /= {
        alphabet idx 13 + 26 mod string-nth 
    } {
        char
    } if
} fn let

'string->block {
    'string swap let
    'i 0 let
    'len string string-length let
    'return { } let
    len 1 - {
        'return return [ string i string-nth ] block-concat set
        'i i 1 + set
    } repeat
    return
} fn let


'rot13 {
    'acc "" let
    'roted swap string->block { char-rot } map let
    roted { 'acc acc rot string-concat set #nil } map drop !副作用なのでdrop (将来的にはfor-eachも欲しい)
    acc
} fn let

'a "emacs is the best text editor in the world!!!" rot13 let
a print
! -> rznpf vf gur orfg grkg rqvgbe va gur jbeyq!!!
newline
'b a rot13 let
b print
! -> emacs is the best text editor in the world!!!
