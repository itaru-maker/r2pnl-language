'alphabet? { !num -> boolean
    {
        { 65 >= } { 90 <= } bi and
    } {
        { 97 >= } { 122 <= } bi and
    } bi or
} fn

'upper? {
    { 65 >= } { 90 <= } bi and
} fn

'rot-char { !char -> newchar
    char->integer
    dup alphabet? {
        dup upper? {
            65 - 13 + 26 % 65 +
        } {
            97 - 13 + 26 % 97 +
        } if
    } {
        noop
    } if
    integer->char
} fn

'rot13 { !str -> newstr
    0 "" !str i acc
    
    { over 3 pick length < } { ! i < len str
        2 pick 2 pick nth rot-char concat
        { 1+ } dip !inc
    } while
    nip nip
} fn

[
    "I can eat glass, it doesn't hurt me."
    "Why don't you give Emacs a try?"
    "Common Lisp（コモン・リスプ）はプログラミング言語であり、Lisp方言の一つである。"
    "啓蟄"
    ""
    "abcdefghijklmnopqrstuvwxyz"
] { rot13 dup . newline rot13 . newline } each
