!可読性が死んでるけど力技で無理やり実装
'def {
    ! bottom ( name params body ) top
    [ rot ]  !name body { params }
    { args } !name body { params } { args }
    rot !name { params } { args } body
    concat concat
    fn let 
} proc let

'greet { name } {
    "Hello, " print
    name print
    "!" print
    newline
} def 

'names { "Sato" "Suzuki" "Takahashi" "Tanaka" "Ito" "Watanabe" "Yamamoto" "Nakamura" "Kobayashi" "Kato" } let
names { greet } each
!names 'greet deref each
!どっちがいいんだろう

