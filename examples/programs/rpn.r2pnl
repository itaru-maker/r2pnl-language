'*stack* { } let

'pop {
    *stack* head '*stack* *stack* tail set
} fn let

'push {
    '*stack* swap *stack* cons set
} fn let

! ========define commands=======
!arithmetic
'add-cmd { pop pop + push } fn let
'sub-cmd { pop pop swap - push } fn let
'mul-cmd { pop pop * push } fn let
'div-cmd { pop pop swap / push } fn let
'mod-cmd { pop pop swap % push } fn let
'power-cmd { pop pop swap ** push } fn let
!stack
'dup-cmd { pop dup push push } fn let
'swap-cmd { pop pop swap push push } fn let
'drop-cmd { pop } fn let
!output
'print-cmd { pop print } fn let
'print-stack-cmd { *stack* print } fn let
!other
'clear-cmd { '*stack* { } set } fn let
! ==============================


'eval-cmd { { cmd } args
    {
        !arithmetic
        { cmd "+" equal? } { add-cmd }
        { cmd "-" equal? } { sub-cmd }
        { cmd "*" equal? } { mul-cmd }
        { cmd "/" equal? } { div-cmd }
        { cmd "%" equal? } { mod-cmd }
        { cmd "**" equal? } { power-cmd }
        !stack
        { cmd "dup" equal? } { dup-cmd }
        { cmd "swap" equal? } { swap-cmd }
        { cmd "drop" equal? } { drop-cmd }
        !output
        { cmd "." equal? } { print-cmd }
        { cmd ".s" equal? } { print-stack-cmd }
        !other
        { cmd "clear" equal? } { clear-cmd }
        { #true } { "unknown operator: " cmd concat print }
    } cond
} fn let

'eval-string { { str } args
    str string->number {
        str string->number push
    } {
        str eval-cmd
    } if 
} fn let

'eval-sentence { 
    dup empty? {
        drop
    } {
        { eval-string } each
    } if
} fn let

'repl {
    'inp "" let
    {
        ">" print
        'inp input set
        inp "q" equal?
        inp "quit" equal?
        inp "exit" equal?
        or or
        not
    } {
        inp " " split eval-sentence
    } while
} fn let

repl !start

"done." print
newline
