!==========定義部==========
!助詞
{ と との が で の を に へ する し し、 して それ 。 、 ！ } { 'noop get let } each

!算術
'和 { + } proc let
'差 { - } proc let
'積 { * } proc let
'商 { / } proc let
'足す { + } proc let
'引く { - } proc let
'掛ける { * } proc let
'割る { / } proc let
'割ったあまり { % } proc let

!入出力
'表示 { print } proc let
'入力 { input } proc let
'改行 { newline } proc let

!変数
'定義 { let } proc let
'書き換え { set } proc let

!配列
'ここから { [ } proc let
'ここまで { ] } proc let
'こと { ] } proc let

!制御
'ならば { } proc let
'でなければ { } proc let
'分岐 { if } proc let
'回繰り返し { swap repeat } proc let

!スタック
'複製 { dup } proc let
'破棄 { drop } proc let
'入れ替え { swap } proc let

!その他
'等しい { equal? } proc let
'手続き化 { proc } proc let
'関数 { fn } proc let
'実行 { do } proc let
!=======================

