!insertion sort
'insert { ! ソート済みのlstに対し、xを追加する
    'lst swap let
    'v swap let
    {
        { lst null-block? } { [ v ] }
        { v lst head <= } { v lst cons }
        { #true } { lst head v lst tail insert cons }
    } cond
} fn let

'sort {
    'lst swap let
    {
        { lst null-block? } { { } }
        { #true } { lst head lst tail sort insert }
    } cond
} fn let



{ 3 4 1 2 4 8 7 5 } sort print
{ 3 } sort print
