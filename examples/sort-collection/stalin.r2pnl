!うーん。汚い！ (書き方が)
!(ネタソートです)

'stalin {
    'lst swap let
    'max 0 let !今までの最大値
    'acc { } let !溜め込むやつ
    'n 0 let !現在のカウント
    lst {
        'n swap set
        n max >= {
            'acc n acc cons set
            'max n set
        } when
    } each
    acc reverse
} fn let

