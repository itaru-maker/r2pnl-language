(ネタソートです)
'sorted? { { lst } args
    'ok #true let
    'i 1 lst length 1 - {
        lst i 1 - nth lst i nth > { 'ok #false set } when
    } for
    ok
} fn let

'thanos { { lst } args
    'half 0 let
    { lst sorted? not } {
        'half lst length 2 / int set
        'lst lst 0 half slice set
    } while
    lst
} fn let


