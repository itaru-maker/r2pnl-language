'quick {
    'lst swap let
    lst length dup 1 = swap 0 = or {
        lst
    } {
        'pivot lst lst length 2 // nth let
        'l lst { pivot < } filter let
        'm lst { pivot = } filter let
        'r lst { pivot > } filter let

        l quick m r quick concat concat
    } if
} fn let


