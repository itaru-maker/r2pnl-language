'sorted? { { lst } args
    'ok #true let
    'i 1 lst length 1 - {
        lst i 1 - nth lst i nth > { 'ok #false set } when
    } for
    ok
} fn let


'miracle { { lst } args
    { lst sorted? not } { } while
    lst
} fn let

