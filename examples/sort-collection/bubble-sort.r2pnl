'bubble {
    'lst swap let
    'i 0 lst length 1 - {
        'j 0 lst length i - 2 - {
            lst j nth lst j 1 + nth > {
                'lst lst j lst j 1 + nth set-nth j 1 + lst j nth set-nth set
            } when
        } for
    } for
    lst
} fn let


